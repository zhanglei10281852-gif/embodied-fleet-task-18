# Embodied Robot Fleet Service - Example Environment Variables

# HTTP listen port (default 58552)
ROBOTFLEET_PORT=58552

# Data directory for SQLite database (default ./data)
ROBOTFLEET_DATA_DIR=./data

# Database file name (default robotfleet.db)
ROBOTFLEET_DB_NAME=robotfleet.db

# Revocable server-side session lifetime and bcrypt work factor
ROBOTFLEET_SESSION_TTL_MINUTES=720
ROBOTFLEET_PASSWORD_COST=12

# Development bootstrap accounts; replace all values outside local development
ROBOTFLEET_DISPATCHER_USERNAME=dispatcher
ROBOTFLEET_DISPATCHER_PASSWORD=dispatch123
ROBOTFLEET_ENGINEER_USERNAME=engineer
ROBOTFLEET_ENGINEER_PASSWORD=engineer123
ROBOTFLEET_AUDITOR_USERNAME=auditor
ROBOTFLEET_AUDITOR_PASSWORD=auditor123

# Request timeout in seconds (default 30)
ROBOTFLEET_REQUEST_TIMEOUT=30

# Scheduler tick interval in seconds (default 5)
ROBOTFLEET_SCHEDULER_INTERVAL=5

# Lease timeout in seconds (default 60)
ROBOTFLEET_LEASE_TIMEOUT=60

# Escalation check interval in seconds (default 10)
ROBOTFLEET_ESCALATION_INTERVAL=10

# Log level: debug, info, warn, error (default info)
ROBOTFLEET_LOG_LEVEL=info

# Executor poll interval in seconds (default 3)
ROBOTFLEET_EXECUTOR_INTERVAL=3

# Executor ID (default auto-generated)
ROBOTFLEET_EXECUTOR_ID=executor-1
